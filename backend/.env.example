PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Base de donnees : sqljs (par defaut, fichier local, zero config) ou postgres.
DB_DRIVER=sqljs
DB_PATH=./data/tag.sqlite

# --- Pour basculer vers PostgreSQL : DB_DRIVER=postgres, puis soit DATABASE_URL
# (format fournisseurs manages type Supabase/Neon/Render), soit les champs
# separes DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME. DB_SSL=true si le
# fournisseur l'exige (la plupart des managed Postgres). Aucun changement de
# code necessaire, seulement ces variables.
# DATABASE_URL=postgres://user:password@host:5432/tag
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=tag
# DB_PASSWORD=change-me
# DB_NAME=tag
# DB_SSL=false
# DB_SYNCHRONIZE=true

# WhatsApp Cloud API (Meta) - a brancher en Sprint 2
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Envoi d'e-mails (SMTP) - utilisé pour les relances de requêtes en attente.
# Laisser vide pour rester en mode démo (journalisation uniquement)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tour d'Avant-Garde <no-reply@tourdavantgarde.org>

# Stockage média S3/compatible (MinIO, Cloudflare R2, DigitalOcean Spaces...)
# Laisser vide pour rester sur le stockage disque local (par defaut)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
